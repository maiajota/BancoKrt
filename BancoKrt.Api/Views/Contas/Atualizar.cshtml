@model BancoKrt.Application.DTOs.ContaDto

@{
    ViewData["Title"] = "Editar Cliente";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg border-0">
            <div class="card-header bg-dark text-white py-3">
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-pencil-square me-2 text-primary"></i> 
                    Editar Nome do Cliente
                </h5>
            </div>
            <div class="card-body p-4 bg-light">
                <form asp-action="Atualizar" method="post">
                    @Html.AntiForgeryToken()
                    
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted">CPF (Não editável)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-lock-fill"></i></span>
                            <input value="@Model.Cpf" class="form-control border-start-0 bg-light text-muted" readonly />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold text-dark">Nome Completo</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-person-fill text-dark"></i></span>
                            <input
                                name="nome"
                                value="@Model.Nome"
                                class="form-control border-start-0 ps-0" 
                                placeholder="Digite o novo nome"
                                required
                                autofocus
                            />
                        </div>
                    </div>

                    <hr class="my-4">

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-dark btn-lg shadow">
                            <i class="bi bi-save me-2 text-primary"></i> Atualizar Nome
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Voltar sem alterar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
