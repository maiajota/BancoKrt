@model BancoKrt.Application.DTOs.ContaDto

@{
    ViewData["Title"] = "Nova Conta";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg border-0">
            <div class="card-header bg-dark text-white py-3">
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-person-plus-fill me-2 text-primary"></i>
                    Abertura de Nova Conta
                </h5>
            </div>
            <div class="card-body p-4 bg-light">
                <form asp-action="Criar" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark">Nome Completo</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-person"></i></span>
                            <input
                                name="nome"
                                maxlength="100"
                                class="form-control border-start-0 ps-0"
                                placeholder="Digite o nome completo"
                                required
                            />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold text-dark">CPF</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-card-text"></i></span>
                            <input 
                                name="cpf"
                                class="form-control border-start-0 ps-0"
                                placeholder="Apenas números"
                                maxlength="11"
                                pattern="\d{11}"
                                title="O CPF deve conter exatamente 11 números"
                                required
                            />
                        </div>
                        <div class="form-text mt-1">Utilize apenas números ou formato padrão.</div>
                    </div>

                    <hr class="my-4">

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-dark btn-lg shadow">
                            <i class="bi bi-check-circle-fill me-2 text-primary"></i> Confirmar Cadastro
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Cancelar e Voltar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
